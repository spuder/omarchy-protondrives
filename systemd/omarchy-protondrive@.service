[Unit]
Description=Proton Drive mount (%i)
Documentation=https://github.com/spencerowen/omarchy-protondrive
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/omarchy-protondrive/%i/env
ExecStart=%h/.local/bin/protondrive-mount
ExecStop=/usr/bin/fusermount3 -u ${PROTONDRIVE_MOUNTPOINT}
Restart=on-failure
RestartSec=5
# rclone's own retry/backoff handles transient Proton Drive API errors; this
# just stops systemd from respawning into a hard failure loop.
StartLimitIntervalSec=120
StartLimitBurst=5

[Install]
WantedBy=default.target

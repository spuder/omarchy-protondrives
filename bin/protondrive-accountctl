#!/usr/bin/env python3
"""Manage Proton Drive accounts: add, remove, pause, resume, list.

State lives under ~/.config/omarchy-protondrive/:
  accounts.json        list of {id, displayName, remote, mountPath}
  <id>/rclone.conf      that account's own rclone config (never shared
                        across accounts, so revoking or corrupting one
                        can't touch another — see PLAN.md)

`add` is meant to run inside a terminal (Service.qml's "Add account" button
launches one) since Proton's login is interactive: SRP username/password,
2FA, and the separate mailbox password, none of which has a browser hand-off
to shell out to the way Dropbox's OAuth link does. `id`/`display_name` fall
back to prompts when not given as arguments, so the bare `add` the GUI
button runs (no arguments — it can't collect text input yet, see PLAN.md
Phase 4) works standalone in a terminal instead of exiting immediately.

Credentials are prompted for *by this script*, not typed at a `rclone
config create` shown to the user. Getting them into rclone without putting
them on that subprocess's command line (visible to any other process on the
system via /proc/<pid>/cmdline for as long as it runs) takes driving
`rclone config create`'s actual interactive wizard through a pseudo
terminal instead of its usual `key=value` arguments -- see `_create_remote`
for why every other approach rclone offers still ends up with a secret on
argv. That wizard only collects and obscures fields locally, though; it
never contacts Proton's API, so after creating the remote this always
re-checks with `rclone about` before calling it a success -- a stub config
with a wrong password fails that check as it should, instead of reporting
"Signed in" for a login that never happened.

Every write to accounts.json goes through atomic_write_accounts: write to a
sibling temp file, then os.replace over the target, and refuse a target that
is a symlink first. Same reasoning as the CPU plugin's state-dir-safety
test — this directory is trusted, so nothing here should follow a symlink
planted in it.
"""

import argparse
import getpass
import json
import os
import pty
import re
import select
import shutil
import subprocess
import sys
import time
from pathlib import Path

STATE_HOME = Path.home() / ".config" / "omarchy-protondrive"
ACCOUNTS_FILE = STATE_HOME / "accounts.json"
MOUNT_ROOT = Path.home() / "ProtonDrive"
UNIT_TEMPLATE = "omarchy-protondrive@{id}.service"
VALID_ID = __import__("re").compile(r"^[a-z0-9][a-z0-9-]{0,63}$")


def fail(message):
    print(f"protondrive-accountctl: {message}", file=sys.stderr)
    sys.exit(1)


def ensure_private_dir(path):
    if path.exists() and path.is_symlink():
        fail(f"refusing to use a symlinked directory: {path}")
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path, 0o700)


def load_accounts():
    if not ACCOUNTS_FILE.exists():
        return []
    if ACCOUNTS_FILE.is_symlink():
        fail(f"refusing to read a symlinked accounts file: {ACCOUNTS_FILE}")
    try:
        with ACCOUNTS_FILE.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return []
    accounts = data.get("accounts") if isinstance(data, dict) else None
    return accounts if isinstance(accounts, list) else []


def atomic_write_accounts(accounts):
    ensure_private_dir(STATE_HOME)
    if ACCOUNTS_FILE.exists() and ACCOUNTS_FILE.is_symlink():
        fail(f"refusing to overwrite a symlinked accounts file: {ACCOUNTS_FILE}")
    tmp = ACCOUNTS_FILE.with_suffix(".json.tmp")
    with tmp.open("w", encoding="utf-8") as handle:
        json.dump({"accounts": accounts}, handle, indent=2)
        handle.write("\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, ACCOUNTS_FILE)


def find_account(accounts, account_id):
    for entry in accounts:
        if entry.get("id") == account_id:
            return entry
    return None


def cmd_list(args):
    accounts = load_accounts()
    if not accounts:
        print("No accounts configured. Add one with: protondrive-accountctl add <id> [display name]")
        return
    for entry in accounts:
        print(f"{entry.get('id')}\t{entry.get('displayName')}\t{entry.get('mountPath')}")


def prompt(label, default=None):
    suffix = f" [{default}]" if default else ""
    value = input(f"{label}{suffix}: ").strip()
    return value or (default or "")


def prompt_yes_no(label):
    return input(f"{label} [y/N]: ").strip().lower() in ("y", "yes")


# rclone error substrings this plugin knows the real cause of, mapped to a
# plain-language explanation. Checked against the raw stderr/stdout from
# `rclone config create`/`rclone about`. Deliberately short: each entry here
# is a pattern actually seen and root-caused, not a guess at rclone's wording
# for something plausible — an unmatched error still shows rclone's own
# message (see friendly_error's docstring) rather than a wrong translation.
_KNOWN_RCLONE_ERRORS = [
    (
        "the main share assumption has failed",
        "This Proton account doesn't have a Drive volume yet — rclone found "
        "zero shares for it. Proton only creates one the first time Drive is "
        "opened from a browser or the official app. Sign in at "
        "https://drive.proton.me with this account once, then try adding it "
        "here again.",
    ),
]


def friendly_error(detail):
    """A plain-language explanation for a known rclone failure, or None to
    fall back to showing rclone's own message. See PLAN.md for why sign-in
    failures generally show rclone's raw output rather than translating
    everything — most errors are one-offs not worth chasing down, but this
    particular one (a never-opened Drive account) is common enough, and
    rclone's own wording ("shares []proton.ShareMetadata{}") is opaque
    enough, that it's worth naming specifically."""
    lowered = detail.lower()
    for needle, message in _KNOWN_RCLONE_ERRORS:
        if needle in lowered:
            return message
    return None


def _create_remote(rclone, account_id, config_path, username, password, twofa, mailbox_password):
    """Create the rclone remote by driving `rclone config create <id>
    protondrive --all` through a pseudo terminal, instead of passing
    username/password/2fa/mailbox_password as command-line arguments.

    Why not argv: those values would sit in this subprocess's argv for its
    whole run, readable by any other process on the system (as this user)
    via /proc/<pid>/cmdline or `ps` — flagged in marketplace review. rclone
    itself offers no non-argv alternative for a *new* remote's fields:
    `--non-interactive` only surfaces backend-specific post-config questions
    (OAuth-style flows) as JSON, not ordinary required fields, which it
    silently defaults instead of asking; its `--continue --result <value>`
    answer-protocol still puts the answer on argv; and neither
    `RCLONE_CONFIG_<name>_<key>` nor the backend's own `RCLONE_PROTONDRIVE_*`
    environment variables are read while creating a remote (checked
    empirically against rclone v1.75.1 -- both are for overriding options on
    an *existing* remote at operation time). A real terminal reading a
    password is the only channel rclone actually treats differently, so
    this drives one via Python's stdlib pty module.

    `config create` here only collects and obscures fields into the config
    file; it never contacts Proton's API (that's the separate, unchanged
    `rclone about` call right after this) -- so there's no live-auth prompt
    variability to handle, just this backend's fixed local wizard, mapped
    by running it for real (see the plugin's dev notes) for every
    username/password/2FA/mailbox-password combination this plugin sends.

    Returns (ok, detail). detail is empty on success; on failure it's a
    short, sanitized diagnostic -- the wizard's own transcript with the
    sent username and 2FA code (the two fields a pty echoes back) redacted.
    Password and mailbox password are never echoed by rclone's own masked
    prompt, confirmed empirically. Never raises; always reaps the child.
    """
    TIMEOUT_SECONDS = 20  # local-only, no network call; generous headroom
    MAX_OUTPUT_BYTES = 200_000  # guards against a future rclone version's
                                 # wizard asking something this doesn't
                                 # recognize and looping instead of exiting

    master, slave = pty.openpty()
    try:
        proc = subprocess.Popen(
            [rclone, "config", "create", account_id, "protondrive",
             "--config", str(config_path), "--all"],
            stdin=slave, stdout=slave, stderr=slave, close_fds=True,
        )
    except OSError as exc:
        os.close(master)
        os.close(slave)
        return False, f"could not start rclone: {exc}"
    os.close(slave)

    buf = ""
    total_out = 0
    cur_field = None
    stage = 0
    advanced_offered = False
    start = time.monotonic()

    def send(text):
        nonlocal buf
        os.write(master, (text + "\n").encode())
        buf = ""

    while True:
        if time.monotonic() - start > TIMEOUT_SECONDS:
            break
        try:
            ready, _, _ = select.select([master], [], [], 0.5)
        except OSError:
            break
        if master in ready:
            try:
                chunk = os.read(master, 4096)
            except OSError:
                chunk = b""
            if not chunk:
                break
            buf += chunk.decode(errors="replace")
            total_out += len(chunk)
            if total_out > MAX_OUTPUT_BYTES:
                break
        if proc.poll() is not None:
            break

        match = re.search(r"Option (\w+)\.", buf)
        if match and match.group(1) != cur_field:
            cur_field = match.group(1)
            stage = 0
        tail = buf.rstrip()

        if cur_field == "username" and tail.endswith("username>"):
            send(username)
        elif cur_field == "password":
            if stage == 0 and tail.endswith("y/g>"):
                stage = 1
                send("y")
            elif stage == 1 and tail.endswith("password:") and "Confirm" not in buf:
                stage = 2
                send(password)
            elif stage == 2 and "Confirm" in buf and tail.endswith("password:"):
                stage = 3
                send(password)
        elif cur_field == "2fa" and tail.endswith("2fa>"):
            send(twofa or "")
        elif cur_field == "otp_secret_key" and tail.endswith("y/g/n>"):
            send("n")  # not a setting this plugin exposes
        elif cur_field == "mailbox_password":
            if stage == 0 and tail.endswith("y/g/n>"):
                stage = 1
                send("y" if mailbox_password else "n")
            elif mailbox_password and stage == 1 and tail.endswith("password:") and "Confirm" not in buf:
                stage = 2
                send(mailbox_password)
            elif mailbox_password and stage == 2 and "Confirm" in buf and tail.endswith("password:"):
                stage = 3
                send(mailbox_password)
        elif "Edit advanced config?" in buf and tail.endswith("y/n>"):
            # mailbox_password only exists under "advanced"; enter it once
            # if needed, decline every later pass so this always terminates
            # (the wizard re-offers advanced config after each full walk).
            want_advanced = bool(mailbox_password) and not advanced_offered
            advanced_offered = True
            send("y" if want_advanced else "n")
        elif cur_field and tail.endswith(f"{cur_field}>"):
            send("")  # any other field (encoding, app_version, ...): default

    try:
        os.close(master)
    except OSError:
        pass
    if proc.poll() is None:
        proc.kill()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()

    if proc.returncode == 0:
        return True, ""

    detail = buf[-2000:]
    if username:
        detail = detail.replace(username, "[username]")
    if twofa:
        detail = detail.replace(twofa, "[2fa]")
    return False, detail.strip() or f"rclone config wizard failed (exit {proc.returncode})"


def perform_add(rclone, account_id, display_name, username, password, twofa, mailbox_password, mount_root=None):
    """The actual create+verify+register, shared by the interactive prompt
    flow and --json (used by Panel.qml's login form — see Service.qml).
    Returns (ok, message). Never raises."""
    if not VALID_ID.match(account_id):
        return False, "id must be lowercase letters, digits, and hyphens, starting with a letter or digit"

    accounts = load_accounts()
    if find_account(accounts, account_id):
        return False, f"account '{account_id}' already exists — remove it first: protondrive-accountctl remove {account_id}"
    if not username or not password:
        return False, "email and password are required"
    # display_name becomes a path component below (MOUNT_ROOT / display_name).
    # pathlib's / silently discards MOUNT_ROOT entirely when the right side
    # is an absolute path, so an unchecked display_name like "/etc" would
    # send the mount somewhere other than under ~/ProtonDrive. "/" has no
    # legitimate use in a display name anyway.
    if "/" in display_name or "\x00" in display_name:
        return False, "display name can't contain '/'"

    # mount_root: the "Mount root" plugin setting (manifest.json's
    # barWidget.defaults.mountRoot), passed through by Service.qml's
    # submitLogin(). Falls back to MOUNT_ROOT for direct terminal use
    # (protondrive-accountctl add), which has no settings to read.
    root_path = Path(os.path.expanduser(mount_root)).resolve() if mount_root else MOUNT_ROOT

    account_dir = STATE_HOME / account_id
    ensure_private_dir(account_dir)
    mount_path = root_path / display_name
    mount_path.mkdir(parents=True, exist_ok=True)
    config_path = account_dir / "rclone.conf"

    # Every rclone call from here down is wrapped — a bad password can make
    # `rclone about` hang for the full timeout instead of failing fast, and
    # an uncaught TimeoutExpired would both crash with a raw traceback and
    # skip the rollback below, leaving an orphaned
    # ~/.config/omarchy-protondrive/<id>/ with a dead rclone.conf in it.
    # Both actually happened while testing this.
    verify_ok = False
    verify_detail = ""
    try:
        create_ok, create_detail = _create_remote(
            rclone, account_id, config_path, username, password, twofa, mailbox_password,
        )
        if create_ok:
            about = subprocess.run(
                [rclone, "about", f"{account_id}:", "--config", str(config_path), "--json"],
                capture_output=True, text=True, timeout=30,
            )
            verify_ok = about.returncode == 0
            verify_detail = (about.stderr or about.stdout or "").strip()
        else:
            verify_detail = create_detail
    except subprocess.TimeoutExpired:
        verify_detail = "rclone did not respond in time (wrong password/2FA can cause this)"

    if not verify_ok:
        # Roll back so the id is free to retry, rather than leaving a
        # permanently broken stub that "already exists" forever after.
        shutil.rmtree(account_dir, ignore_errors=True)
        friendly = friendly_error(verify_detail)
        if friendly:
            return False, friendly
        return False, f"sign-in failed, nothing was saved. rclone said:\n  {verify_detail or 'unknown error'}"

    accounts.append({
        "id": account_id,
        "displayName": display_name,
        "remote": account_id,
        "mountPath": str(mount_path),
    })
    atomic_write_accounts(accounts)

    env_path = account_dir / "env"
    with env_path.open("w", encoding="utf-8") as handle:
        handle.write(f"PROTONDRIVE_REMOTE={account_id}\n")
        handle.write(f"PROTONDRIVE_MOUNTPOINT={mount_path}\n")
        handle.write(f"PROTONDRIVE_CONFIG={config_path}\n")
    os.chmod(env_path, 0o600)

    return True, f"Signed in and verified. Start syncing with: systemctl --user enable --now {UNIT_TEMPLATE.format(id=account_id)}"


def cmd_add(args):
    rclone = _require_rclone()  # fail before asking anything, not after

    if args.json:
        # Driven by Panel.qml's login form over stdin, not a terminal — see
        # Service.qml's submitLogin(). One line of JSON in, one line of JSON
        # out; every field the interactive prompts below collect, collected
        # by the form instead. The password/2FA/mailbox password arrive over
        # stdin, never argv, the same way the first-party network plugin
        # sends Wi-Fi passwords ("the password goes over stdin, never argv").
        try:
            payload = json.loads(sys.stdin.readline())
        except json.JSONDecodeError:
            print(json.dumps({"ok": False, "error": "malformed request"}))
            sys.exit(1)
        account_id = str(payload.get("id", "")).strip().lower()
        display_name = str(payload.get("displayName") or account_id.replace("-", " ").title())
        ok, message = perform_add(
            rclone, account_id, display_name,
            str(payload.get("username", "")), str(payload.get("password", "")),
            str(payload.get("twofa", "")), str(payload.get("mailboxPassword", "")),
            mount_root=str(payload.get("mountRoot", "")).strip() or None,
        )
        print(json.dumps({"ok": ok, "error": "" if ok else message, "message": message if ok else ""}))
        sys.exit(0 if ok else 1)

    account_id = (args.id or prompt("Account id, e.g. personal")).strip().lower()
    default_name = account_id.replace("-", " ").title()
    display_name = args.display_name or prompt("Display name", default_name)

    print()
    print(f"Signing in to Proton Drive for '{account_id}' ({display_name}).")
    print("This talks directly to rclone's protondrive backend — nothing is sent anywhere else.")
    username = prompt("Proton account email")
    password = getpass.getpass("Proton account password: ")
    twofa = getpass.getpass("2FA code (leave blank if not enabled): ")
    mailbox_password = ""
    if prompt_yes_no("Does this account use a separate mailbox password (old Proton accounts only)?"):
        mailbox_password = getpass.getpass("Mailbox password: ")

    print()
    print("Contacting Proton...")
    ok, message = perform_add(rclone, account_id, display_name, username, password, twofa, mailbox_password)
    print()
    if ok:
        print(message)
    else:
        fail(message)


def cmd_remove(args):
    accounts = load_accounts()
    entry = find_account(accounts, args.id)
    if not entry:
        fail(f"no such account: {args.id}")

    unit = UNIT_TEMPLATE.format(id=args.id)
    subprocess.call(["systemctl", "--user", "disable", "--now", unit],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    remaining = [a for a in accounts if a.get("id") != args.id]
    atomic_write_accounts(remaining)
    print(f"Removed '{args.id}' from Proton Drive. Its rclone config and local mount folder were left in place:")
    print(f"  {STATE_HOME / args.id}")
    print(f"  {entry.get('mountPath', '')}")
    print("Delete them yourself once you've confirmed nothing still needs them.")


def _control(args, action, unit_state):
    """action is "enable" or "disable", always combined with --now: pause and
    resume must change both current state and boot persistence together, or
    the panel's toggle lies about what happens on the next reboot. Plain
    start/stop only changed the former -- add/resume looked like they took
    effect, but the unit stayed disabled, so accounts silently reverted to
    disconnected on every reboot until someone ran `systemctl --user enable
    --now` by hand. See PLAN.md / the "why are drives disconnected on boot"
    report this fixes."""
    accounts = load_accounts()
    entry = find_account(accounts, args.id)
    if not entry:
        fail(f"no such account: {args.id}")
    unit = UNIT_TEMPLATE.format(id=args.id)
    exit_code = subprocess.call(["systemctl", "--user", action, "--now", unit])
    if exit_code != 0:
        fail(f"systemctl --user {action} --now {unit} failed (exit {exit_code})")
    print(f"{args.id}: {unit_state}")


def cmd_pause(args):
    _control(args, "disable", "paused")


def cmd_resume(args):
    _control(args, "enable", "resumed")


def _require_rclone():
    rclone = shutil.which("rclone")
    if not rclone:
        fail("rclone is not installed — run the install script first")
    return rclone


def main():
    parser = argparse.ArgumentParser(prog="protondrive-accountctl")
    sub = parser.add_subparsers(dest="command", required=True)

    p_list = sub.add_parser("list", help="list configured accounts")
    p_list.set_defaults(func=cmd_list)

    p_add = sub.add_parser("add", help="add and sign in to a new account")
    p_add.add_argument("id", nargs="?", default=None, help="short id, e.g. personal (prompted for if omitted)")
    p_add.add_argument("display_name", nargs="?", default=None, help="display name, e.g. \"Personal\" (prompted for if omitted)")
    p_add.add_argument("--json", action="store_true",
                        help="non-interactive: read one JSON line from stdin "
                             "({id, displayName, username, password, twofa, mailboxPassword}), "
                             "print one JSON line back. Used by Panel.qml's login form.")
    p_add.set_defaults(func=cmd_add)

    p_remove = sub.add_parser("remove", help="stop and forget an account (keeps local files)")
    p_remove.add_argument("id")
    p_remove.set_defaults(func=cmd_remove)

    p_pause = sub.add_parser("pause", help="stop an account's mount/sync unit")
    p_pause.add_argument("id")
    p_pause.set_defaults(func=cmd_pause)

    p_resume = sub.add_parser("resume", help="start an account's mount/sync unit")
    p_resume.add_argument("id")
    p_resume.set_defaults(func=cmd_resume)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()

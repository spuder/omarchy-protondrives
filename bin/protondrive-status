#!/usr/bin/python3 -I
"""Read-only status helper for the Proton Drive Quickshell panel.

Prints one JSON object on stdout, shaped for Model.js's parseAccounts():

    {"ok": true, "rcloneInstalled": bool, "accounts": [...], "lastError": ""}

Each account comes from ~/.config/omarchy-protondrive/accounts.json (written
by protondrive-accountctl) plus two checks: whether its systemd user unit is
active (-> "active" — cheap and local, so this always runs fresh), and a
quota/auth check (-> "authenticated", plus usage/quota when it does). That
second check uses one of two sources, never both at once for the same
account:

  - active (mounted): a readdir health check plus statfs on the live mount
    path, piggybacking on the mount daemon's already-authenticated session
    instead of starting a second one. See mount_quota's docstring — running
    a second, independent `rclone about` process against the same
    rclone.conf while the mount is live is what used to intermittently
    break these mounts (Proton rotates refresh tokens on every use, so two
    processes refreshing independently race to invalidate each other).
  - not active (paused / never mounted yet): a direct `rclone about` call,
    since there's no competing process to race against.

Either way, the result is cached per account (see CACHE_TTL_SECONDS): the
panel refreshes every ~30s by default, and Proton Drive's API is
reverse-engineered rather than official (see PLAN.md), so polling it live
on every refresh — for every account — isn't something to do by accident.
A healthy result is trusted for the TTL; an error is always rechecked
immediately, so a lapsed/expired sign-in doesn't stay hidden behind a stale
cache.

Never raises — a missing rclone, a missing config directory, or a hung
`rclone about` call all degrade to a normal-looking JSON object with the
account's `lastError` field set, the same way the first-party Dropbox
plugin's status.py reports "not installed" instead of crashing the panel.

--demo prints a fixed two-account fixture instead of touching the real
config or rclone — used by test/status-fixture.sh and for previewing the
panel's layout before any account is actually configured.
"""

import configparser
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

STATE_HOME = Path.home() / ".config" / "omarchy-protondrive"
ACCOUNTS_FILE = STATE_HOME / "accounts.json"
UNIT_TEMPLATE = "omarchy-protondrive@{id}.service"
CACHE_TTL_SECONDS = 600

# See protondrive-accountctl's matching constant for why: resolve/invoke
# every security-relevant executable from a fixed, trusted set of
# directories rather than whatever PATH this process happened to inherit.
TRUSTED_PATH = "/usr/bin:/usr/local/bin"
SYSTEMCTL = "/usr/bin/systemctl"
FINDMNT = "/usr/bin/findmnt"
STAT = "/usr/bin/stat"


def demo_payload():
    return {
        "ok": True,
        "rcloneInstalled": True,
        "accounts": [
            {
                "id": "personal",
                "displayName": "Personal",
                "authenticated": True,
                "active": True,
                "statusText": "Syncing",
                "mountPath": str(Path.home() / "ProtonDrive" / "Personal"),
                "usedBytes": 4_200_000_000,
                "quotaBytes": 20_000_000_000,
                "quotaKnown": True,
                "lastError": "",
            },
            {
                "id": "work",
                "displayName": "Work",
                "authenticated": True,
                "active": False,
                "statusText": "Paused",
                "mountPath": str(Path.home() / "ProtonDrive" / "Work"),
                "usedBytes": 61_000_000_000,
                "quotaBytes": 500_000_000_000,
                "quotaKnown": True,
                "lastError": "",
            },
        ],
        "lastError": "",
    }


def command_output(command, timeout=4):
    try:
        completed = subprocess.run(
            command, check=False, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return completed.returncode, (completed.stdout or "").strip()


def load_accounts():
    if not ACCOUNTS_FILE.exists():
        return []
    if ACCOUNTS_FILE.is_symlink():
        # Matches protondrive-accountctl's own refusal to follow a symlinked
        # accounts file -- this script just degrades to "no accounts" instead
        # of accountctl's fail()/exit, since a status query must never raise.
        return []
    try:
        with ACCOUNTS_FILE.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return []
    accounts = data.get("accounts") if isinstance(data, dict) else None
    return accounts if isinstance(accounts, list) else []


def config_has_credentials(config_path):
    """True if the account's rclone.conf has a username set — a cheap local
    check that doesn't need a network round trip, and doesn't require the
    section name to match the account id (rclone writes it from the remote
    name passed to `config create`, which has always been the account id
    here, but this reads whichever section exists rather than assuming)."""
    parser = configparser.ConfigParser()
    try:
        parser.read(config_path)
    except configparser.Error:
        return False
    for section in parser.sections():
        if parser.get(section, "username", fallback="").strip():
            return True
    return False


def unit_active(account_id):
    unit = UNIT_TEMPLATE.format(id=account_id)
    exit_code, _ = command_output([SYSTEMCTL, "--user", "is-active", "--quiet", unit], timeout=3)
    return exit_code == 0


def cache_path(account_id):
    return STATE_HOME / account_id / "quota-cache.json"


def load_cache(account_id):
    path = cache_path(account_id)
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def save_cache(account_id, data):
    path = cache_path(account_id)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data), encoding="utf-8")
    os.chmod(tmp, 0o600)  # usage/activity metadata, same as accountctl's other
                          # state files -- the parent dir is already 0700, but
                          # this shouldn't depend only on that holding true
    tmp.replace(path)  # same directory, so this is an atomic rename like accountctl's writes


def is_rclone_mount(mount_path):
    """True only if mount_path is *currently* the mountpoint of a live
    fuse.rclone filesystem -- not just an existing directory. Guards
    mount_quota below: if the mount has died and mount_path reverted to
    a plain directory on the host filesystem, `findmnt --target` resolves
    to the covering host mount (btrfs/ext4/...) instead, whose fstype
    doesn't start with "fuse.rclone", so we correctly refuse to read it
    rather than silently reporting the host partition's free space as this
    account's Proton Drive quota."""
    exit_code, output = command_output(
        [FINDMNT, "-no", "FSTYPE", "--target", str(mount_path)], timeout=3,
    )
    return exit_code == 0 and output.startswith("fuse.rclone")


def mount_is_healthy(mount_path):
    """True only if a readdir on the live mount actually succeeds -- the
    same FUSE operation that surfaces as "Input/output error" to a user
    once the mount daemon's auth session has gone bad. Run as `ls`, not
    Python's own os.listdir, so a hung (not just erroring) FUSE daemon
    can't block this script past the timeout -- same discipline as every
    other external call in this file."""
    exit_code, _ = command_output(["/usr/bin/ls", "-A", str(mount_path)], timeout=5)
    return exit_code == 0


def mount_quota(mount_path):
    """Quota for a live mount, piggybacking on rclone mount's own
    Statfs()->About() call through the mount daemon's already-authenticated
    session -- instead of running a second, independent `rclone about`
    process against the same rclone.conf.

    That second process is what breaks these mounts: Proton rotates the
    refresh token on every use, so when the long-running mount daemon and
    this status script's periodic `rclone about` both happen to refresh
    around the same time, whichever writes rclone.conf last invalidates
    the token the other is still holding in memory. The next refresh from
    the "loser" -- often the mount daemon itself, since it's typically been
    running far longer -- gets "Invalid refresh token (Code=10013)" and
    wedges the whole mount with a sticky de-auth error that every
    subsequent read surfaces as Input/output error, until the account is
    fully re-authenticated. Reading through the existing mount's own
    session instead of starting a competing one removes that race for the
    common case (an account that's actually mounted).

    Health is checked with mount_is_healthy (an actual readdir) before
    trusting statfs's numbers, not statfs alone: empirically, rclone mount's
    Statfs() can return a bogus placeholder (observed: ~1 PiB total, 0
    used) instead of failing when the backing session is dead, which would
    otherwise misreport a broken account as fully healthy.

    Returns None (never raises) if the mount isn't responding, isn't
    actually a live rclone mount, or stat's output doesn't parse --
    callers should treat that the same as a failed `rclone about`, not
    fall back to spawning one while the mount is still live, which would
    just reintroduce the same race."""
    if not is_rclone_mount(mount_path) or not mount_is_healthy(mount_path):
        return None
    exit_code, output = command_output([STAT, "-f", "--format=%b:%f:%S", str(mount_path)], timeout=5)
    if exit_code != 0:
        return None
    try:
        blocks, free_blocks, block_size = (int(part) for part in output.split(":"))
    except ValueError:
        return None
    total = blocks * block_size
    free = free_blocks * block_size
    if total <= 0:
        return None
    return {
        "authenticated": True,
        "usedBytes": max(total - free, 0),
        "quotaBytes": total,
        "quotaKnown": True,
        "lastError": "",
        "statusHint": "",
    }


def cached_or_fetch(account_id, fetch):
    """Shared TTL-cache dance for both quota sources (mount_quota and
    `rclone about`): a healthy result is trusted for CACHE_TTL_SECONDS, an error is
    never cached so a lapsed/expired sign-in doesn't stay hidden behind a
    stale cache. `fetch` is a zero-arg callable returning a quota dict."""
    cache = load_cache(account_id)
    fresh_enough = (
        cache is not None
        and cache.get("authenticated") is True
        and not cache.get("lastError")
        and (time.time() - cache.get("checkedAt", 0)) < CACHE_TTL_SECONDS
    )
    if fresh_enough:
        return cache
    quota = fetch()
    save_cache(account_id, dict(quota, checkedAt=time.time()))
    return quota


def fetch_quota(rclone_path, remote, config_path):
    """One live `rclone about` call. Returns a dict with authenticated/
    usedBytes/quotaBytes/quotaKnown/lastError/statusHint — never raises."""
    exit_code, output = command_output(
        [rclone_path, "about", f"{remote}:", "--config", str(config_path), "--json"],
        timeout=6,
    )
    if exit_code != 0:
        return {
            "authenticated": False, "usedBytes": 0, "quotaBytes": 0, "quotaKnown": False,
            "lastError": "Sign-in expired or network unreachable", "statusHint": "Needs attention",
        }
    try:
        about = json.loads(output)
    except json.JSONDecodeError:
        about = {}
    used = about.get("used")
    total = about.get("total")
    return {
        "authenticated": True,
        "usedBytes": used if isinstance(used, (int, float)) else 0,
        "quotaBytes": total if isinstance(total, (int, float)) and total > 0 else 0,
        "quotaKnown": isinstance(total, (int, float)) and total > 0,
        "lastError": "",
        "statusHint": "",
    }


def account_status(rclone_path, entry):
    account_id = str(entry.get("id", ""))
    display_name = str(entry.get("displayName", account_id))
    remote = str(entry.get("remote", account_id))
    mount_path = str(entry.get("mountPath", ""))
    config_path = STATE_HOME / account_id / "rclone.conf"

    active = unit_active(account_id) if account_id else False
    result = {
        "id": account_id,
        "displayName": display_name,
        "authenticated": False,
        "active": active,
        "statusText": "Paused" if not active else "Syncing",
        "mountPath": mount_path,
        "usedBytes": 0,
        "quotaBytes": 0,
        "quotaKnown": False,
        "lastError": "",
    }

    if rclone_path is None:
        result["lastError"] = "rclone is not installed"
        return result
    if not config_path.exists() or not config_has_credentials(config_path):
        # A config file can exist without ever having signed in — a login
        # that failed partway (or, before this was fixed, `rclone config
        # create` silently defaulting unanswered questions instead of
        # prompting, see protondrive-accountctl) leaves a bare `type =
        # protondrive` stub with no username. Checking locally, instead of
        # letting `rclone about` fail against it, avoids reporting the
        # misleading "expired" below for an account that never actually
        # signed in — a real, previously-fixed point of confusion.
        result["lastError"] = "Not signed in yet"
        return result

    # A healthy quota check is cached for CACHE_TTL_SECONDS to avoid polling
    # Proton's (reverse-engineered) API on every panel refresh. An error is
    # never cached — always recheck immediately, so an expired sign-in shows
    # up right away instead of waiting out the TTL.
    #
    # While active (mounted), read quota through the live mount (statvfs)
    # instead of spawning a second `rclone about` process against the same
    # rclone.conf the mount daemon is using — see mount_quota's docstring
    # for the refresh-token-rotation race that running both causes. Only
    # fall back to a direct `rclone about` call when nothing is mounted, so
    # there's no competing process to race against.
    if active:
        def do_fetch():
            quota = mount_quota(mount_path)
            if quota is not None:
                return quota
            return {
                "authenticated": False, "usedBytes": 0, "quotaBytes": 0, "quotaKnown": False,
                "lastError": "Mount isn't responding (I/O error) — may need to re-authenticate",
                "statusHint": "Needs attention",
            }
    else:
        def do_fetch():
            return fetch_quota(rclone_path, remote, config_path)

    quota = cached_or_fetch(account_id, do_fetch)

    result["authenticated"] = quota["authenticated"]
    result["usedBytes"] = quota["usedBytes"]
    result["quotaBytes"] = quota["quotaBytes"]
    result["quotaKnown"] = quota["quotaKnown"]
    result["lastError"] = quota["lastError"]
    result["statusText"] = quota["statusHint"] or ("Syncing" if active else "Paused")
    return result


def main():
    if "--demo" in sys.argv[1:]:
        print(json.dumps(demo_payload()))
        return

    rclone_path = shutil.which("rclone", path=TRUSTED_PATH)
    entries = load_accounts()
    accounts = [account_status(rclone_path, entry) for entry in entries if isinstance(entry, dict)]

    print(json.dumps({
        "ok": True,
        "rcloneInstalled": rclone_path is not None,
        "accounts": accounts,
        "lastError": "",
    }))


if __name__ == "__main__":
    main()

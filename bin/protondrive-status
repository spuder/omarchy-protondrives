#!/usr/bin/env python3
"""Read-only status helper for the Proton Drive Quickshell panel.

Prints one JSON object on stdout, shaped for Model.js's parseAccounts():

    {"ok": true, "rcloneInstalled": bool, "accounts": [...], "lastError": ""}

Each account comes from ~/.config/omarchy-protondrive/accounts.json (written
by protondrive-accountctl) plus two checks: whether its systemd user unit is
active (-> "active" — cheap and local, so this always runs fresh), and
whether `rclone about` succeeds against its own per-account config (->
"authenticated", plus usage/quota when it does).

The `rclone about` check is cached per account (see CACHE_TTL_SECONDS): the
panel refreshes every ~30s by default, and Proton Drive's API is
reverse-engineered rather than official (see PLAN.md), so polling it live
on every refresh — for every account — isn't something to do by accident.
A healthy result is trusted for the TTL; an error is always rechecked
immediately, so a lapsed/expired sign-in doesn't stay hidden behind a stale
cache.

Never raises — a missing rclone, a missing config directory, or a hung
`rclone about` call all degrade to a normal-looking JSON object with the
account's `lastError` field set, the same way the first-party Dropbox
plugin's status.py reports "not installed" instead of crashing the panel.

--demo prints a fixed two-account fixture instead of touching the real
config or rclone — used by test/status-fixture.sh and for previewing the
panel's layout before any account is actually configured.
"""

import configparser
import json
import shutil
import subprocess
import sys
import time
from pathlib import Path

STATE_HOME = Path.home() / ".config" / "omarchy-protondrive"
ACCOUNTS_FILE = STATE_HOME / "accounts.json"
UNIT_TEMPLATE = "omarchy-protondrive@{id}.service"
CACHE_TTL_SECONDS = 600


def demo_payload():
    return {
        "ok": True,
        "rcloneInstalled": True,
        "accounts": [
            {
                "id": "personal",
                "displayName": "Personal",
                "authenticated": True,
                "active": True,
                "statusText": "Syncing",
                "mountPath": str(Path.home() / "ProtonDrive" / "Personal"),
                "usedBytes": 4_200_000_000,
                "quotaBytes": 20_000_000_000,
                "quotaKnown": True,
                "lastError": "",
            },
            {
                "id": "work",
                "displayName": "Work",
                "authenticated": True,
                "active": False,
                "statusText": "Paused",
                "mountPath": str(Path.home() / "ProtonDrive" / "Work"),
                "usedBytes": 61_000_000_000,
                "quotaBytes": 500_000_000_000,
                "quotaKnown": True,
                "lastError": "",
            },
        ],
        "lastError": "",
    }


def command_output(command, timeout=4):
    try:
        completed = subprocess.run(
            command, check=False, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""
    return completed.returncode, (completed.stdout or "").strip()


def load_accounts():
    if not ACCOUNTS_FILE.exists():
        return []
    try:
        with ACCOUNTS_FILE.open("r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, json.JSONDecodeError):
        return []
    accounts = data.get("accounts") if isinstance(data, dict) else None
    return accounts if isinstance(accounts, list) else []


def config_has_credentials(config_path):
    """True if the account's rclone.conf has a username set — a cheap local
    check that doesn't need a network round trip, and doesn't require the
    section name to match the account id (rclone writes it from the remote
    name passed to `config create`, which has always been the account id
    here, but this reads whichever section exists rather than assuming)."""
    parser = configparser.ConfigParser()
    try:
        parser.read(config_path)
    except configparser.Error:
        return False
    for section in parser.sections():
        if parser.get(section, "username", fallback="").strip():
            return True
    return False


def unit_active(account_id):
    unit = UNIT_TEMPLATE.format(id=account_id)
    exit_code, _ = command_output(["systemctl", "--user", "is-active", "--quiet", unit], timeout=3)
    return exit_code == 0


def cache_path(account_id):
    return STATE_HOME / account_id / "quota-cache.json"


def load_cache(account_id):
    path = cache_path(account_id)
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def save_cache(account_id, data):
    path = cache_path(account_id)
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data), encoding="utf-8")
    tmp.replace(path)  # same directory, so this is an atomic rename like accountctl's writes


def fetch_quota(rclone_path, remote, config_path):
    """One live `rclone about` call. Returns a dict with authenticated/
    usedBytes/quotaBytes/quotaKnown/lastError/statusHint — never raises."""
    exit_code, output = command_output(
        [rclone_path, "about", f"{remote}:", "--config", str(config_path), "--json"],
        timeout=6,
    )
    if exit_code != 0:
        return {
            "authenticated": False, "usedBytes": 0, "quotaBytes": 0, "quotaKnown": False,
            "lastError": "Sign-in expired or network unreachable", "statusHint": "Needs attention",
        }
    try:
        about = json.loads(output)
    except json.JSONDecodeError:
        about = {}
    used = about.get("used")
    total = about.get("total")
    return {
        "authenticated": True,
        "usedBytes": used if isinstance(used, (int, float)) else 0,
        "quotaBytes": total if isinstance(total, (int, float)) and total > 0 else 0,
        "quotaKnown": isinstance(total, (int, float)) and total > 0,
        "lastError": "",
        "statusHint": "",
    }


def account_status(rclone_path, entry):
    account_id = str(entry.get("id", ""))
    display_name = str(entry.get("displayName", account_id))
    remote = str(entry.get("remote", account_id))
    mount_path = str(entry.get("mountPath", ""))
    config_path = STATE_HOME / account_id / "rclone.conf"

    active = unit_active(account_id) if account_id else False
    result = {
        "id": account_id,
        "displayName": display_name,
        "authenticated": False,
        "active": active,
        "statusText": "Paused" if not active else "Syncing",
        "mountPath": mount_path,
        "usedBytes": 0,
        "quotaBytes": 0,
        "quotaKnown": False,
        "lastError": "",
    }

    if rclone_path is None:
        result["lastError"] = "rclone is not installed"
        return result
    if not config_path.exists() or not config_has_credentials(config_path):
        # A config file can exist without ever having signed in — a login
        # that failed partway (or, before this was fixed, `rclone config
        # create` silently defaulting unanswered questions instead of
        # prompting, see protondrive-accountctl) leaves a bare `type =
        # protondrive` stub with no username. Checking locally, instead of
        # letting `rclone about` fail against it, avoids reporting the
        # misleading "expired" below for an account that never actually
        # signed in — a real, previously-fixed point of confusion.
        result["lastError"] = "Not signed in yet"
        return result

    # A healthy quota check is cached for CACHE_TTL_SECONDS to avoid polling
    # Proton's (reverse-engineered) API on every panel refresh. An error is
    # never cached — always recheck immediately, so an expired sign-in shows
    # up right away instead of waiting out the TTL.
    cache = load_cache(account_id)
    fresh_enough = (
        cache is not None
        and cache.get("authenticated") is True
        and not cache.get("lastError")
        and (time.time() - cache.get("checkedAt", 0)) < CACHE_TTL_SECONDS
    )

    quota = cache if fresh_enough else fetch_quota(rclone_path, remote, config_path)
    if not fresh_enough:
        save_cache(account_id, dict(quota, checkedAt=time.time()))

    result["authenticated"] = quota["authenticated"]
    result["usedBytes"] = quota["usedBytes"]
    result["quotaBytes"] = quota["quotaBytes"]
    result["quotaKnown"] = quota["quotaKnown"]
    result["lastError"] = quota["lastError"]
    result["statusText"] = quota["statusHint"] or ("Syncing" if active else "Paused")
    return result


def main():
    if "--demo" in sys.argv[1:]:
        print(json.dumps(demo_payload()))
        return

    rclone_path = shutil.which("rclone")
    entries = load_accounts()
    accounts = [account_status(rclone_path, entry) for entry in entries if isinstance(entry, dict)]

    print(json.dumps({
        "ok": True,
        "rcloneInstalled": rclone_path is not None,
        "accounts": accounts,
        "lastError": "",
    }))


if __name__ == "__main__":
    main()
